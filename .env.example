# =============================================================================
# SaborExpress — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo como .env e preencha os valores.
#   cp .env.example .env
#
# Variáveis marcadas como (OBRIGATÓRIA) DEVEM ser preenchidas.
# As demais possuem valores padrão seguros para desenvolvimento local.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# SERVIDOR
# ─────────────────────────────────────────────────────────────────────────────

# Porta onde o backend será executado.
# Desenvolvimento: mantenha 3001 (os Vite proxies apontam para esta porta).
# Produção: pode alterar, mas lembre de ajustar os proxies nos Dockerfiles/nginx.
PORT=3001

# Ambiente de execução.
# Valores: development | production
# Em development: CORS permite qualquer origem, CSP permite unsafe-eval (Vite HMR),
#   rate limiters são desabilitados.
# Em production: CORS é restrito, CSP é mais rigorosa, rate limiters ativos.
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# BANCO DE DADOS (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────

# Host do PostgreSQL.
# Docker: use o nome do serviço (ex: postgres) ou IP do container.
# Local: localhost ou IP da máquina.
DB_HOST=localhost

# Porta do PostgreSQL.
DB_PORT=5432

# Nome do banco de dados.
DB_NAME=delivery

# Usuário do banco de dados.
DB_USER=default

# Senha do banco de dados.
DB_PASS=default

# ─────────────────────────────────────────────────────────────────────────────
# JWT (JSON Web Token)
# ─────────────────────────────────────────────────────────────────────────────

# Senha para assinar os tokens JWT.
# OBRIGATÓRIA em produção — o servidor NÃO inicia sem ela.
# Em development, usa um valor padrão (não seguro).
# Gere uma chave forte com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET= 

# Tempo de expiração do token de acesso.
# Formato: números seguidos de unidade (s = segundos, m = minutos, h = horas, d = dias).
JWT_EXPIRES_IN=365d

# Tempo de expiração do refresh token (usado para renovar o access token).
JWT_REFRESH_EXPIRES_IN=365d

# ─────────────────────────────────────────────────────────────────────────────
# NEGÓCIO / MULTI-TENANT
# ─────────────────────────────────────────────────────────────────────────────

# ID do restaurante no banco de dados (chave estrangeira da tabela restaurantes).
# Útil se no futuro o sistema suportar múltiplos restaurantes na mesma base.
RESTAURANT_ID=1

# ─────────────────────────────────────────────────────────────────────────────
# CORS (Cross-Origin Resource Sharing)
# ─────────────────────────────────────────────────────────────────────────────

# Origens permitidas para requisições CORS (separadas por vírgula).
# Em desenvolvimento com Vite, inclua as URLs dos 3 frontends:
#   http://localhost:5173  (Cliente)
#   http://localhost:5174  (Admin)
#   http://localhost:5175  (Entregador)
# Em produção, substitua pelos domínios reais.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ─────────────────────────────────────────────────────────────────────────────
# UPLOAD DE ARQUIVOS
# ─────────────────────────────────────────────────────────────────────────────

# Diretório onde as imagens de produtos serão armazenadas.
# Em Docker, monte este diretório como volume para persistência.
UPLOAD_DIR=./uploads

# Tamanho máximo de arquivo em bytes (padrão: 5 MB).
MAX_FILE_SIZE=5242880

# ─────────────────────────────────────────────────────────────────────────────
# ASAAS — GATEWAY DE PAGAMENTOS
# ─────────────────────────────────────────────────────────────────────────────

# Chave de API do Asaas (obrigatória para checkout PIX/Cartão).
# Obtenha em: https://sandbox.asaas.com (sandbox) ou https://www.asaas.com (produção)
# Acesse: Conta → Integração → Chave de API
ASAAS_API_KEY=

# Ambiente do Asaas.
# Valores: sandbox | production
# Sandbox: usa https://api-sandbox.asaas.com (para testes)
# Produção: usa https://api.asaas.com (requer conta verificada)
ASAAS_ENV=sandbox

# Token de autenticação do webhook Asaas.
# Configurado em: Conta → Integração → Webhook
# O Asaas envia este token no header `access_token` das chamadas de webhook.
ASAAS_WEBHOOK_TOKEN=

# Segredo HMAC para verificar a assinatura dos webhooks do Asaas.
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configure o mesmo valor no painel do Asaas em: Webhook → Segredo HMAC
ASAAS_WEBHOOK_SECRET=

# Tempo de expiração do QR Code PIX em minutos.
# O Asaas aceita valores entre 30 e 60 minutos.
ASAAS_PIX_EXPIRY=30

# Timeout das requisições à API do Asaas em milissegundos.
ASAAS_REQUEST_TIMEOUT=30000

# ─────────────────────────────────────────────────────────────────────────────
# PUSH NOTIFICATIONS (VAPID / Web Push)
# ─────────────────────────────────────────────────────────────────────────────
# Necessário para enviar notificações push aos clientes sobre status do pedido.
# Se não configurado, as notificações push são desabilitadas (sem erro).
#
# Gere as chaves VAPID com:
#   npx web-push generate-vapid-keys
#
# O e-mail (mailto) é configurado no código em backend/src/services/push.js.
# Altere para o e-mail de contato do restaurante.

# Chave pública VAPID.
VAPID_PUBLIC_KEY=

# Chave privada VAPID.
VAPID_PRIVATE_KEY=
