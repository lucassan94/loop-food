# =============================================================================
# loop-food — Stack Environment (Portainer)
# =============================================================================
# Este arquivo contém APENAS variáveis que SOBRESCREVEM os valores padrão
# do docker-compose.yml. As demais configurações são:
#   - Banco de dados, CORS, Upload → defaults no docker-compose.yml
#   - Rede (credenciais por-tenant), JWT por tenant → configurados no banco de dados (multi-tenant)
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# JWT — Segredo GLOBAL (fallback quando tenant não tem jwt_secret próprio)
# Gere um valor seguro com: node -e "console.log(require('crypto')
#   .randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production

# ─────────────────────────────────────────────────────────────────────────────
# PUSH NOTIFICATIONS (VAPID) — Para notificações PWA
# Gere novas chaves com: npx web-push generate-vapid-keys
# ─────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=BK0cjLBgIl9jSYV7-5e6UCHWdGXgrvs-dcRJ45fj9vSSaFnnvIOvbzoNaYQaBh5HsuS2mWPRGheE0iARCSjRcIk
VAPID_PRIVATE_KEY=pVT0VRZ5ZXa4otstFDAHcpZtEKqm0ctRg9aKGUBWORE

# ─────────────────────────────────────────────────────────────────────────────
# BANCO DE DADOS (migration 029 — role app_user, RLS ativo)
# ⚠️ REPO PÚBLICO: NUNCA commitar senhas reais aqui. DB_PASS deve ser definido
#    como OVERRIDE DE AMBIENTE no Portainer (stack restaurante-v3 → env vars).
#    DB_ADMIN_USER/PASS são usados apenas por migrations/seeds (DDL) e também
#    devem ser sobrescritos no Portainer após rotacionar a senha do superuser.
# ─────────────────────────────────────────────────────────────────────────────
DB_USER=app_user
DB_PASS=nBjXk0mBr9VZ9lWJljLEUenOddfTXgHq
DB_ADMIN_USER=default
DB_ADMIN_PASS=default
