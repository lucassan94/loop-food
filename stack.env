# =============================================================================
# loop-food — Stack Environment (Portainer)
# =============================================================================
# Este arquivo é lido pelo Portainer ao fazer deploy via repositório Git.
# As variáveis abaixo substituem os valores padrão do docker-compose.yml.
#
# IMPORTANTE: Para usar os valores REAIS (JWT, Asaas), edite este arquivo
# diretamente no servidor via Portainer (Volumes -> Browse -> stack.env)
# ou crie o arquivo .env na mesma pasta do docker-compose.yml.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# JWT — SUBSTITUA pelo secret real (valor abaixo é fallback seguro)
# O código exibe um aviso no log se estiver usando este valor padrão.
# Gere um seguro com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production

# ─────────────────────────────────────────────────────────────────────────────
# ASAAS — SUBSTITUA pelas credenciais reais
# Cada tenant pode ter a própria chave no BD (restaurantes.asaas_api_key).
# A chave abaixo é o fallback global (usada quando o tenant não tem chave própria).
# ─────────────────────────────────────────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
ASAAS_WEBHOOK_SECRET=
ASAAS_PIX_EXPIRY=30

# ─────────────────────────────────────────────────────────────────────────────
# CORS — Origens permitidas para a API (separadas por vírgula)
# Incluir TODOS os IPs e domínios que consomem a API:
#   - IPs dos containers (acesso direto)
#   - Domínios dos tenants via Nginx Proxy Manager
# ─────────────────────────────────────────────────────────────────────────────
# CORS_ORIGIN=http://86.48.18.22:8091,http://86.48.18.22:8092,http://86.48.18.22:8093

# ─────────────────────────────────────────────────────────────────────────────
# MULTI-TENANT — ID do restaurante padrão (fallback)
# Usado quando o tenantResolver não consegue identificar o tenant
# (ex: health check do Docker, acesso por IP, webhooks).
# ─────────────────────────────────────────────────────────────────────────────
# RESTAURANT_ID=1

# ─────────────────────────────────────────────────────────────────────────────
# PUSH NOTIFICATIONS (VAPID) — Para notificações PWA
# Gere novas chaves com: npx web-push generate-vapid-keys
# ─────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
