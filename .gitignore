# =====================================
# MIGRATIONS
# =====================================
# migrations/ NÃO está aqui: as migrations são commitadas e o container
# monta ./migrations:/app/migrations no deploy (GitHub → Portainer)

# =====================================
# DEPENDÊNCIAS
# =====================================
node_modules/

# =====================================
# BUILD
# =====================================
dist/
run.bat

# =====================================
# AMBIENTE
# =====================================
.env
.env.local
.env.*.local

# =====================================
# SISTEMA
# =====================================
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
*.log

# =====================================
# IDE
# =====================================
.vscode/
.idea/
*.sublime-workspace

# =====================================
# UPLOADS (apenas o .gitkeep)
# =====================================
uploads/*
!uploads/.gitkeep
app/backend/uploads/*
!app/backend/uploads/.gitkeep

# =====================================
# IMAGENS NÃO ESSENCIAIS (exceto ícones de PWA)
# =====================================
*.png
*.jpg
*.jpeg
!cliente/public/**/*.png
!cliente/public/**/*.jpg
!restaurante/public/**/*.png
!restaurante/public/**/*.jpg
!entregador/public/**/*.png
!entregador/public/**/*.jpg

# =====================================
# DEPLOY (credenciais da VPS — nunca commitar)
# =====================================
deploy_config.json

# =====================================
# FERRAMENTAS LOCAIS E LIXO (não vão para a VPS)
# =====================================
god/
trash/
others/asd
others/tmp_placeholder_check/

# Cache do dev server (Vite)
.vite/
