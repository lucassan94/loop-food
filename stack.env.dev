# =============================================================================
# loop-food — Ambiente de DESENVOLVIMENTO (Portainer Stack Env)
# =============================================================================
# Use estas variáveis na stack dev do Portainer.
# Crie um banco delivery_dev antes de iniciar.
# =============================================================================

# ─── Database Dev ──────────────────────────────────────────────────────────
DEV_DB_HOST=86.48.18.22
DEV_DB_PORT=5432
DEV_DB_NAME=delivery_dev
DEV_DB_USER=default
DEV_DB_PASS=sua_senha_do_banco_dev

# ─── JWT ──────────────────────────────────────────────────────────────────
DEV_JWT_SECRET=dev-secret-change-in-portainer-too

# ─── CORS (em dev, liberar tudo) ─────────────────────────────────────────
DEV_CORS_ORIGIN=*

# ─── Asaas Sandbox ────────────────────────────────────────────────────────
DEV_ASAAS_API_KEY=
DEV_ASAAS_ENV=sandbox
DEV_ASAAS_WEBHOOK_TOKEN=
DEV_ASAAS_WEBHOOK_SECRET=
