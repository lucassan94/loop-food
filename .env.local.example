# =============================================================================
# loop-food — Ambiente de Desenvolvimento Local (EXEMPLO)
# =============================================================================
# Copie este arquivo como .env.local e preencha com suas credenciais.
# cp .env.local.example .env.local
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────
# Crie o banco delivery_dev antes: CREATE DATABASE delivery_dev;
DB_HOST=86.48.18.22
DB_PORT=5432
DB_NAME=delivery_dev
DB_USER=default
DB_PASS=coloque_sua_senha_aqui

# ─── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-local-change-me

# ─── Ambiente ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── CORS (liberar todas as origins em dev) ──────────────────────────────
CORS_ORIGIN=*

# ─── Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── Asaas (opcional: usar sandbox para testes) ─────────────────────────
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_WEBHOOK_SECRET=
